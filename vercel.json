{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/willie-toribio/academy(.*)",
      "destination": "/academy",
      "permanent": true
    },
    {
      "source": "/willie-toribio/chi-siamo(.*)",
      "destination": "/chi-siamo.html",
      "permanent": true
    },
    {
      "source": "/willie-toribio/fleet(.*)",
      "destination": "/fleet.html",
      "permanent": true
    },
    {
      "source": "/willie-toribio/index(.*)",
      "destination": "/",
      "permanent": true
    }
  ]
}
